{
  "name": "tk-designer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter=@tk-designer/webview --filter=tk-designer --filter=@tk-designer/cli run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tools",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm --filter tk-designer check:schema && pnpm test",
    "generate:schema": "pnpm --filter tk-designer generate:schema",
    "catalog:extract": "tclsh tools/catalog/extract.tcl packages/core/src/catalog/tk-raw.json",
    "layout:record": "node tools/layout/record.mts",
    "codegen:verify-python": "node tools/codegen/verify-python.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
